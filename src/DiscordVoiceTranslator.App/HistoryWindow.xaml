<Window x:Class="DiscordVoiceTranslator.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordVoiceTranslator.App"
        Title="{local:Tr En='Subtitle history', Fr='Historique des sous-titres'}"
        Width="580" Height="660" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Petit bouton icône, discret, pour les actions sur une ligne. -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="2,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{local:Tr En='Copy all', Fr='Tout copier'}" Click="CopyAll_Click" Margin="0,0,6,0" />
                <Button Content="{local:Tr En='Export...', Fr='Exporter...'}" Click="Export_Click" Margin="0,0,6,0" />
                <Button Content="{local:Tr En=Clear, Fr=Effacer}" Click="Clear_Click" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"
                       Text="{local:Tr En=History, Fr=Historique}" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Entries">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14,9,6,10" Margin="0,0,0,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="Copy_Click"
                                            ToolTip="{local:Tr En=Copy, Fr=Copier}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xED1A;" Click="Hide_Click"
                                            Visibility="{Binding HideVisibility}"
                                            ToolTip="{local:Tr En='Stop subtitling this person', Fr='Ne plus sous-titrer cette personne'}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="12">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Speaker, Mode=OneWay}" Foreground="{Binding SpeakerBrush, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Original}" Visibility="{Binding OriginalVisibility}"
                                               Style="{StaticResource Hint}" FontStyle="Italic" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Text="{local:Tr En='Nothing yet. Subtitled lines will be listed here.', Fr='Rien pour l’instant. Les lignes sous-titrées s’afficheront ici.'}" />

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,10,0,0"
                   Text="{local:Tr En='Only the last 500 lines of this session are kept, nothing is saved unless you export.', Fr='Seules les 500 dernières lignes de cette session sont gardées, rien n’est enregistré sauf si tu exportes.'}" />
    </Grid>
</Window>
