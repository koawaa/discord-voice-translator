<Window x:Class="DiscordVoiceTranslator.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordVoiceTranslator.App"
        Title="Discord Voice Translator - overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        MinWidth="300" MinHeight="120">
    <Grid>
        <!-- Cadre et fond visibles uniquement en mode édition : ils rendent toute la surface saisissable.
             En retrait de 6 px : les poignées posées sur le trait restent entières dans la fenêtre. -->
        <Border x:Name="EditFrame" Visibility="Collapsed" CornerRadius="8" Margin="6"
                BorderThickness="2" BorderBrush="#CC4FA3FF" Background="#99101418" />

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="EditHeader" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,6">
                <!-- Place des trois boutons à droite (Pause, Paramètres, ✕). -->
                <StackPanel Margin="0,0,210,0">
                    <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{local:Tr En='Edit mode: drag to move, edges and corners to resize', Fr='Mode édition : glisser pour déplacer, bords et coins pour redimensionner'}" />
                    <TextBlock Foreground="#FFB8C2CC" FontSize="12" TextWrapping="Wrap"
                               Text="{local:Tr En='Snaps to the screen edges and center · Shift: no snapping · Ctrl: resize from the center · Esc: cancel', Fr='S’aimante aux bords et au centre de l’écran · Maj : sans aimant · Ctrl : depuis le centre · Échap : annuler'}" />
                    <TextBlock x:Name="HotkeyHelp" Foreground="#FFB8C2CC" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" Foreground="#FF8FD18F" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="PauseButton" Click="Pause_Click"
                            Height="28" Padding="10,0" Margin="0,0,6,0"
                            Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" />
                    <Button Content="{local:Tr En=Settings..., Fr=Paramètres...}" Click="Settings_Click"
                            Height="28" Padding="10,0" Margin="0,0,6,0"
                            Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" />
                    <Button Content="✕" ToolTip="{local:Tr En=Quit, Fr=Quitter}" Click="Quit_Click" Width="28" Height="28"
                            Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Placeholder" Grid.Row="1" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="16"
                       Text="{local:Tr En='Subtitles will appear here', Fr='Les sous-titres s’afficheront ici'}" />

            <!-- Les lignes s'empilent par le bas : la plus récente est toujours au même endroit. -->
            <StackPanel x:Name="Lines" Grid.Row="1" VerticalAlignment="Bottom" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Reste affiché verrouillé : on ne doit pas oublier que plus rien n'est sous-titré. -->
                <Border x:Name="PausedIndicator" Visibility="Collapsed"
                        Margin="0,4,6,0" Padding="8,2" CornerRadius="4" Background="#88000000">
                    <TextBlock Foreground="#FFFFC864" FontSize="13" FontWeight="SemiBold"
                               Text="{local:Tr En='❚❚ paused (Ctrl+Alt+F11)', Fr='❚❚ en pause (Ctrl+Alt+F11)'}" />
                </Border>
                <Border x:Name="BusyIndicator" Visibility="Collapsed"
                        Margin="0,4,0,0" Padding="8,2" CornerRadius="4" Background="#88000000">
                    <TextBlock Foreground="#FFB8C2CC" FontSize="13" FontStyle="Italic"
                               Text="{local:Tr En='● listening...', Fr='● en cours...'}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Taille en cours, seulement pendant un glissement. -->
        <Border x:Name="SizeBadge" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,5" CornerRadius="6"
                Background="#E6101418" BorderBrush="#CC4FA3FF" BorderThickness="1">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <!-- Poignées des bords et des coins, créées par OverlayResizer. Par-dessus tout le reste. -->
        <Grid x:Name="ResizeHandles" Visibility="Collapsed" />
    </Grid>
</Window>
