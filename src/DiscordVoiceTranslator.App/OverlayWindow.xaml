<Window x:Class="DiscordVoiceTranslator.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordVoiceTranslator.App"
        Title="Discord Voice Translator - overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        MinWidth="300" MinHeight="120">
    <Grid>
        <!-- Cadre et fond visibles uniquement en mode édition : ils rendent toute la surface saisissable. -->
        <Border x:Name="EditFrame" Visibility="Collapsed" CornerRadius="8"
                BorderThickness="2" BorderBrush="#CC4FA3FF" Background="#99101418" />

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="EditHeader" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,6">
                <StackPanel Margin="0,0,130,0">
                    <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{local:Tr En='Edit mode: drag to move, bottom-right corner to resize', Fr='Mode édition : glisser pour déplacer, coin bas-droit pour redimensionner'}" />
                    <TextBlock x:Name="HotkeyHelp" Foreground="#FFB8C2CC" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" Foreground="#FF8FD18F" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{local:Tr En=Settings..., Fr=Paramètres...}" Click="Settings_Click"
                            Height="28" Padding="10,0" Margin="0,0,6,0"
                            Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" />
                    <Button Content="✕" ToolTip="{local:Tr En=Quit, Fr=Quitter}" Click="Quit_Click" Width="28" Height="28"
                            Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Placeholder" Grid.Row="1" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="16"
                       Text="{local:Tr En='Subtitles will appear here', Fr='Les sous-titres s’afficheront ici'}" />

            <!-- Les lignes s'empilent par le bas : la plus récente est toujours au même endroit. -->
            <StackPanel x:Name="Lines" Grid.Row="1" VerticalAlignment="Bottom" />

            <Border x:Name="BusyIndicator" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Left"
                    Margin="0,4,0,0" Padding="8,2" CornerRadius="4" Background="#88000000">
                <TextBlock Foreground="#FFB8C2CC" FontSize="13" FontStyle="Italic"
                           Text="{local:Tr En='● listening...', Fr='● en cours...'}" />
            </Border>
        </Grid>
    </Grid>
</Window>
