<Window x:Class="DiscordVoiceTranslator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordVoiceTranslator.App"
        Title="{local:Tr En='Discord Voice Translator - Settings', Fr='Traducteur vocal Discord - Paramètres'}"
        Width="860" Height="660" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Navigation latérale : un onglet = une entrée avec son icône (glyphe dans Tag). -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Margin="0,0,0,2">
                                <Border x:Name="Bd" CornerRadius="6" Padding="12,9" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Margin="14,20,14,14">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                                        <!-- Même bulle que l'icône de la zone de notification. -->
                                        <Viewbox Width="30" Height="30" VerticalAlignment="Center">
                                            <Canvas Width="32" Height="32">
                                                <Rectangle Canvas.Left="1" Canvas.Top="2" Width="30" Height="22" RadiusX="6" RadiusY="6" Fill="#4FA3FF" />
                                                <Polygon Points="7,21 15,21 6,30" Fill="#4FA3FF" />
                                                <Rectangle Canvas.Left="7" Canvas.Top="8" Width="18" Height="4" Fill="White" />
                                                <Rectangle Canvas.Left="7" Canvas.Top="15" Width="12" Height="4" Fill="White" />
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"
                                                       Text="{local:Tr En='Voice Translator', Fr='Traducteur vocal'}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{local:Tr En=Settings, Fr=Paramètres}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                                </DockPanel>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Page" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="32,26,32,12" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fond de la barre latérale, sur toute la hauteur (la navigation est dessinée par le TabControl). -->
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" />

        <TabControl x:Name="Tabs" Grid.ColumnSpan="2">
            <!-- Général -->
            <TabItem Header="{local:Tr En=General, Fr=Général}" Tag="&#xE713;">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{local:Tr En=General, Fr=Général}" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Interface language', Fr='Langue de l’interface'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:Tr En='Applied after a restart.', Fr='Appliquée après un redémarrage.'}" />
                                </StackPanel>
                                <ComboBox x:Name="UiLanguageBox" Grid.Column="1" Width="200" VerticalAlignment="Center">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Français" Tag="fr" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <CheckBox x:Name="UpdatesBox">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}"
                                               Text="{local:Tr En='Tell me when a new version is out', Fr='Me prévenir quand une nouvelle version sort'}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="{local:Tr En='At startup, asks GitHub for the latest version number. Nothing else is sent, and nothing is installed without you.', Fr='Au démarrage, demande à GitHub le numéro de la dernière version. Rien d’autre n’est envoyé, et rien ne s’installe sans toi.'}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=TRANSLATION, Fr=TRADUCTION}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="TranslateBox">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Translate what people say', Fr='Traduire ce que disent les gens'}" />
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="{local:Tr En='Translate into', Fr='Traduire vers'}" />
                                    <ComboBox x:Name="TargetBox" Grid.Column="1" Width="220" DisplayMemberPath="DisplayName" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox x:Name="ShowOriginalBox">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}"
                                                   Text="{local:Tr En='Show the original text in small under the translation', Fr='Afficher le texte original en petit sous la traduction'}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="{local:Tr En='Sentences already in the target language are shown as they are (no DeepL call).', Fr='Les phrases déjà dans la langue cible s’affichent telles quelles (sans appel à DeepL).'}" />
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox x:Name="InformalBox">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}"
                                                   Text="{local:Tr En='Casual tone', Fr='Ton familier (tutoiement)'}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="{local:Tr En='Translate with “tu” rather than “vous” (and the like) in languages that make the difference. Others are unaffected.', Fr='Traduit avec « tu » plutôt que « vous » (et l’équivalent ailleurs) dans les langues qui font la différence. Sans effet sur les autres.'}" />
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox x:Name="VocabularyBox">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}"
                                                   Text="{local:Tr En='Recognize names and game vocabulary', Fr='Reconnaître les pseudos et le vocabulaire du jeu'}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="{local:Tr En='The names of the people in your Discord voice channel, and the terms of the game that is running (if it has a vocabulary list), are spelled correctly and never translated.', Fr='Les pseudos des gens de ton salon vocal Discord, et les termes du jeu en cours (s’il a une liste de vocabulaire), sont écrits correctement et jamais traduits.'}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=STATUS, Fr=ÉTAT}" />
                        <Border Style="{StaticResource Card}" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBlock x:Name="StatusBox" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sources audio -->
            <TabItem x:Name="AudioTab" Header="Audio" Tag="&#xE767;">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{local:Tr En='Audio sources', Fr='Sources audio'}" />

                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource Body}"
                                       Text="{local:Tr En='Choose whose voices get subtitles. Only the sound of these apps is listened to, never your microphone or the rest of the PC.', Fr='Choisis de quelles applis les voix sont sous-titrées. Seul le son de ces applis est écouté, jamais ton micro ni le reste du PC.'}" />
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="DISCORD" />
                        <Border Style="{StaticResource Card}">
                            <CheckBox x:Name="CaptureDiscordBox">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Subtitle Discord', Fr='Sous-titrer Discord'}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="{local:Tr En='Voice channels and calls, with names and avatars (Discord tab).', Fr='Salons vocaux et appels, avec pseudos et avatars (onglet Discord).'}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En='GAMES AND OTHER APPS', Fr='JEUX ET AUTRES APPLIS'}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="{local:Tr En='Add a game with voice chat (CS2, War Dogs...) or any app that plays voices. Its lines are labelled with its name.', Fr='Ajoute un jeu avec un chat vocal (CS2, War Dogs...) ou n’importe quelle appli qui diffuse des voix. Ses lignes portent son nom.'}" />

                                <ItemsControl x:Name="AppsList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBrush}" CornerRadius="6" Padding="12,8,8,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ExeName}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Padding="9" Background="Transparent" VerticalAlignment="Center"
                                                            Click="RemoveApp_Click" ToolTip="{local:Tr En='Stop subtitling this app', Fr='Ne plus sous-titrer cette appli'}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoAppsText" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="{local:Tr En='No other app yet.', Fr='Aucune autre appli pour l’instant.'}" />

                                <TextBlock Style="{StaticResource Label}" Margin="0,10,0,8" Text="{local:Tr En='Add an open app', Fr='Ajouter une appli ouverte'}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="RunningAppsBox">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                    <Run Text="{Binding ExeName, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{StaticResource TextMutedBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="RefreshAppsButton" Grid.Column="1" Margin="8,0,0,0" Padding="11,0" Click="RefreshApps_Click"
                                            ToolTip="{local:Tr En='Refresh the list', Fr='Actualiser la liste'}">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Click="AddApp_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{local:Tr En='Add', Fr='Ajouter'}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr En='Launch the game first so it shows up here. Next time, it is found again on its own, even if it starts after this app.', Fr='Lance d’abord le jeu pour qu’il apparaisse ici. Ensuite, il est retrouvé tout seul, même s’il démarre après cette appli.'}" />
                                <TextBlock x:Name="AppsResult" Style="{StaticResource Hint}" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Padding="14,10" Background="{StaticResource AccentSoftBrush}">
                            <DockPanel>
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{local:Tr En='The whole sound of a game is listened to: music or songs with lyrics can give false lines. Each extra app also asks a little more of the PC.', Fr='Tout le son d’un jeu est écouté : une musique ou des chansons avec paroles peuvent donner de fausses lignes. Chaque appli en plus demande aussi un peu plus au PC.'}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Overlay -->
            <TabItem Header="Overlay" Tag="&#xE7F4;">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Overlay" />

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En='SUBTITLE THEME', Fr='THÈME DES SOUS-TITRES'}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="{local:Tr En='Applies to the next lines. The previews follow the font and background opacity below.', Fr='S’applique aux lignes suivantes. Les aperçus suivent la police et l’opacité du fond ci-dessous.'}" />
                                <!-- Marges négatives : rattrapent l'espace laissé à droite et sous chaque carte. -->
                                <UniformGrid x:Name="ThemesPanel" Columns="2" Margin="0,0,-8,-8" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=APPEARANCE, Fr=APPARENCE}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="{local:Tr En=Font, Fr=Police}" />
                                    <ComboBox x:Name="FontBox" Grid.Column="1" Width="260">
                                        <ComboBox.ItemTemplate>
                                            <!-- Chaque police s'affiche dans son propre style. -->
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:0} px}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Text size', Fr='Taille du texte'}" />
                                </DockPanel>
                                <Slider x:Name="FontSizeSlider" Margin="0,8,0,0" Minimum="12" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <Border Style="{StaticResource Divider}" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0} %}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Background opacity', Fr='Opacité du fond'}" />
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Margin="0,8,0,0" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=SUBTITLES, Fr=SOUS-TITRES}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=LinesSlider, StringFormat={}{0:0}}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Lines shown at once', Fr='Lignes affichées en même temps'}" />
                                </DockPanel>
                                <Slider x:Name="LinesSlider" Margin="0,8,0,0" Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <Border Style="{StaticResource Divider}" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=DurationSlider, StringFormat={}{0:0} s}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Time on screen before fading', Fr='Durée d’affichage avant estompage'}" />
                                </DockPanel>
                                <Slider x:Name="DurationSlider" Margin="0,8,0,0" Minimum="3" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox x:Name="LiveBox">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}"
                                                   Text="{local:Tr En='Live subtitles', Fr='Sous-titres en direct'}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="{local:Tr En='On long sentences (over 2–3 seconds), the text appears and is translated while the person is still speaking, then is corrected when they finish. Easier to follow monologues and videos, but uses the graphics card more and more DeepL characters.', Fr='Sur les phrases longues (plus de 2 à 3 secondes), le texte s’affiche et se traduit pendant que la personne parle encore, puis se corrige quand elle a fini. Plus facile à suivre pour un monologue ou une vidéo, mais sollicite davantage la carte graphique et consomme plus de caractères DeepL.'}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="POSITION" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="{local:Tr En='To move or resize it: Ctrl+Alt+F9 (edit mode), drag it or pull its edges and corners, then Ctrl+Alt+F9 again to lock it. It snaps to the screen edges and center (hold Shift to place it freely, Ctrl to resize from the center). Ctrl+Alt+F10 hides or shows it.', Fr='Pour le déplacer ou le redimensionner : Ctrl+Alt+F9 (mode édition), fais-le glisser ou tire ses bords et ses coins, puis de nouveau Ctrl+Alt+F9 pour le verrouiller. Il s’aimante aux bords et au centre de l’écran (Maj enfoncée pour le placer librement, Ctrl pour redimensionner depuis le centre). Ctrl+Alt+F10 le masque ou l’affiche.'}" />
                                <Button Content="{local:Tr En='Put the overlay back at the bottom center, at its original size', Fr='Remettre l’overlay en bas au centre, à sa taille d’origine'}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetPosition_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Transcription -->
            <TabItem x:Name="TranscriptionTab" Header="Transcription" Tag="&#xE720;">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Transcription" />

                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,18" Background="{StaticResource AccentSoftBrush}">
                            <DockPanel>
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{local:Tr En='Changes on this tab are applied after a restart.', Fr='Les changements de cet onglet s’appliquent après un redémarrage.'}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En='SPEECH MODEL', Fr='MODÈLE DE RECONNAISSANCE'}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="{local:Tr En='Fast is lighter on the PC; Accurate makes fewer mistakes but asks more of it. A new model is downloaded once, at the next start.', Fr='Rapide ménage le PC ; Précis fait moins d’erreurs mais lui demande plus. Un nouveau modèle est téléchargé une seule fois, au prochain démarrage.'}" />
                                <StackPanel x:Name="ModelsPanel" Margin="0,0,0,-8" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=LANGUAGES, Fr=LANGUES}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Languages people speak', Fr='Langues parlées par les gens'}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                           Text="{local:Tr En='Whisper only picks among these. Fewer languages means fewer wrong detections on short sentences.', Fr='Whisper ne choisit que parmi celles-ci. Moins de langues, c’est moins d’erreurs de détection sur les phrases courtes.'}" />
                                <WrapPanel x:Name="LanguagesPanel" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=DETECTION, Fr=DÉTECTION}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=SilenceSlider, StringFormat={}{0:0} ms}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Pause that ends a sentence', Fr='Pause qui termine une phrase'}" />
                                </DockPanel>
                                <Slider x:Name="SilenceSlider" Margin="0,8,0,0" Minimum="300" Maximum="1500" IsSnapToTickEnabled="True" TickFrequency="50" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr En='Shorter: subtitles appear sooner, but sentences may be cut in two. Longer: whole sentences, shown later.', Fr='Plus court : les sous-titres arrivent plus vite, mais les phrases peuvent être coupées en deux. Plus long : phrases entières, affichées plus tard.'}" />
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox x:Name="UseGpuBox">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Use the graphics card (recommended)', Fr='Utiliser la carte graphique (recommandé)'}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="{local:Tr En='Without it, Whisper runs on the processor: much slower, and heavier on games.', Fr='Sans elle, Whisper tourne sur le processeur : bien plus lent, et plus lourd pour les jeux.'}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DeepL -->
            <TabItem x:Name="DeepLTab" Header="DeepL" Tag="&#xE8C1;">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="DeepL" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="{local:Tr En='Translation uses DeepL. The free plan gives 500,000 characters per month, plenty for voice chat.', Fr='La traduction passe par DeepL. L’offre gratuite donne 500 000 caractères par mois, largement assez pour du vocal.'}" />
                                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold">
                                    <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="Link_RequestNavigate">
                                        <Run Text="{local:Tr En='Get a free DeepL API key', Fr='Obtenir une clé API DeepL gratuite'}" />
                                        <Run Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr En='Choose the DeepL API Free plan, then copy your key from your account page (it ends with :fx).', Fr='Choisis l’offre DeepL API Free, puis copie ta clé depuis la page de ton compte (elle finit par :fx).'}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En='API KEYS', Fr='CLÉS API'}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="{local:Tr En='Keys are used from top to bottom. When the monthly quota of one runs out, the next one takes over automatically.', Fr='Les clés servent de haut en bas. Quand le quota du mois de l’une est épuisé, la suivante prend le relais automatiquement.'}" />

                                <ItemsControl x:Name="KeysList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBrush}" CornerRadius="6" Padding="12,8,8,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Masked}" FontFamily="Consolas" FontSize="13" />
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Padding="9" Background="Transparent" VerticalAlignment="Center"
                                                            Click="RemoveKey_Click" ToolTip="{local:Tr En='Remove this key', Fr='Retirer cette clé'}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoKeysText" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="{local:Tr En='No key yet.', Fr='Aucune clé pour l’instant.'}" />

                                <TextBlock Style="{StaticResource Label}" Margin="0,10,0,8" Text="{local:Tr En='Add a key', Fr='Ajouter une clé'}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="DeepLKeyBox" />
                                    <Button x:Name="AddKeyButton" Grid.Column="1" Margin="8,0,0,0" Click="AddKey_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{local:Tr En='Add', Fr='Ajouter'}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr En='Each key is checked before being added, then encrypted with your Windows account (DPAPI).', Fr='Chaque clé est vérifiée avant d’être ajoutée, puis chiffrée avec ton compte Windows (DPAPI).'}" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="CheckKeyButton" Content="{local:Tr En='Check the keys', Fr='Vérifier les clés'}" Click="CheckKey_Click" />
                                    <TextBlock x:Name="DeepLResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Discord -->
            <TabItem x:Name="DiscordTab" Header="Discord" Tag="&#xE716;">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Discord" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="{local:Tr En='To show who is talking (name and avatar), the app asks your own Discord client. No bot is involved, but Discord needs an application that you create once (2 minutes):', Fr='Pour afficher qui parle (pseudo et avatar), l’appli interroge ton propre client Discord. Aucun bot n’est utilisé, mais Discord demande une application que tu crées une fois (2 minutes) :'}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0">
                                    <Run Text="1. " /><Hyperlink NavigateUri="https://discord.com/developers/applications" RequestNavigate="Link_RequestNavigate"><Run Text="{local:Tr En='Open the Discord Developer Portal', Fr='Ouvre le portail développeur Discord'}" /></Hyperlink><Run Text="{local:Tr En=' and click New Application (any name).', Fr=' et clique sur New Application (n’importe quel nom).'}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                           Text="{local:Tr En='2. Open the OAuth2 page: copy the Client ID, then click Reset Secret and copy the Client Secret.', Fr='2. Ouvre la page OAuth2 : copie le Client ID, puis clique sur Reset Secret et copie le Client Secret.'}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                           Text="{local:Tr En='3. On the same page, under Redirects, add http://localhost and click Save Changes.', Fr='3. Sur la même page, dans Redirects, ajoute http://localhost et clique sur Save Changes.'}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                           Text="{local:Tr En='4. Paste both values below and save. Discord then asks you to authorize the app: click Authorize.', Fr='4. Colle les deux valeurs ci-dessous et enregistre. Discord te demande alors d’autoriser l’appli : clique sur Autoriser.'}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="APPLICATION" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,8" Text="Client ID" />
                                <TextBox x:Name="ClientIdBox" />
                                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="Client Secret" />
                                <PasswordBox x:Name="ClientSecretBox" />
                                <TextBlock x:Name="ClientSecretHint" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En=NAMES, Fr=PSEUDOS}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=MarginSlider, StringFormat={}{0:0} ms}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{local:Tr En='Name matching tolerance', Fr='Tolérance pour attribuer les pseudos'}" />
                                </DockPanel>
                                <Slider x:Name="MarginSlider" Margin="0,8,0,0" Minimum="100" Maximum="1000" IsSnapToTickEnabled="True" TickFrequency="50" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr En='Discord’s talking indicator is slightly out of sync with the sound. Raise this if lines often show no name.', Fr='L’indicateur « parle » de Discord est un peu décalé par rapport au son. Augmente si des lignes s’affichent souvent sans pseudo.'}" />
                                <Border Style="{StaticResource Divider}" />
                                <Button Content="{local:Tr En='Forget the Discord authorization', Fr='Oublier l’autorisation Discord'}" HorizontalAlignment="Left"
                                        Click="ForgetAuthorization_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{local:Tr En='HIDDEN PEOPLE', Fr='PERSONNES MASQUÉES'}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="{local:Tr En='What they say is neither subtitled nor translated (no DeepL characters used). To hide someone: in the history (Ctrl+Alt+H), the hide button on one of their lines.', Fr='Ce qu’elles disent n’est ni sous-titré ni traduit (aucun caractère DeepL consommé). Pour masquer quelqu’un : dans l’historique (Ctrl+Alt+H), le bouton masquer sur l’une de ses lignes.'}" />
                                <ItemsControl x:Name="HiddenList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBrush}" CornerRadius="6" Padding="12,8,8,8" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="{local:Tr En=Show again, Fr=Réafficher}" Click="UnhideSpeaker_Click" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoHiddenText" Style="{StaticResource Hint}"
                                           Text="{local:Tr En='Nobody is hidden.', Fr='Personne n’est masqué.'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Pied de page, sous le contenu : message éventuel et boutons. -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{local:Tr En=Cancel, Fr=Annuler}" Padding="18,8" IsCancel="True" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="{local:Tr En=Save, Fr=Enregistrer}"
                            Padding="18,8" Margin="10,0,0,0" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
